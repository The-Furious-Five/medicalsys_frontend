server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # El SPA de Angular usa rutas relativas (/api/v1/...); Nginx las reenvia
    # tal cual (sin recortar el path) al gateway real.
    location /api/ {
        proxy_pass ${API_GATEWAY_URL};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /actuator/ {
        proxy_pass ${API_GATEWAY_URL};
        proxy_set_header Host $host;
    }

    # Fallback de SPA: cualquier ruta que no sea un archivo real cae en index.html
    # para que el router de Angular la resuelva en el cliente.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
