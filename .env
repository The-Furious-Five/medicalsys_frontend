# Configuracion local del frontend. Este archivo NO se versiona (ver .gitignore).
# Copiar de .env.example y ajustar segun donde este corriendo el backend.

# URL base del ms-gateway al que apunta el proxy de `ng serve`.
# Todas las llamadas del frontend usan rutas relativas (/api/v1/...), asi que
# el proxy es quien las reenvia a este destino. Mantener las URLs relativas es
# obligatorio: el interceptor solo adjunta el token en peticiones que empiezan
# por /api/ y ademas evita problemas de CORS con el gateway.
# Gateway local levantado con `docker compose up -d` en medicalsys-platform_v1
# (puerto GATEWAY_HOST_PORT del .env de ese repo, por defecto 8080).
API_TARGET=http://localhost:8080

# Alternativa remota: tunel de cloudflared apuntando al gateway. La URL cambia
# cada vez que se reinicia `cloudflared`, hay que actualizarla y reiniciar `npm start`.
# API_TARGET=https://mild-anywhere-toys-sat.trycloudflare.com
